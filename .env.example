NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
OPENAI_API_KEY=  # 任意。未設定ならメイク提案はルールベースにフォールバック

# エラー監視（任意）。未設定なら Sentry へは送らず、ログ出力だけになる
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=  # 任意。既定は Vercel の環境名
SENTRY_TRACES_SAMPLE_RATE=       # 任意。既定は 0.1
# ソースマップを Sentry に送る場合だけ設定する（3つ揃ったときだけ有効）
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
