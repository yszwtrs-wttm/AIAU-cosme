NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORM=  # 既定で Storage の画像変換（リサイズ/WebP）を通す。使えない環境は false
# OPENAI_API_KEY はアプリ側では使わない。Edge Function makeup-plan のシークレットに置く。
#   supabase secrets set OPENAI_API_KEY=... MAKEUP_PLAN_DAILY_LIMIT=10
#   ローカルは supabase/functions/.env（gitignore 済み）に書く
