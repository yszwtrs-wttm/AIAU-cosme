NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
NEXT_PUBLIC_SITE_URL=  # 任意。OG画像の絶対URLに使う。Vercel では VERCEL_URL にフォールバック
NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORM=  # 既定で Storage の画像変換（リサイズ/WebP）を通す。使えない環境は false
OPENAI_API_KEY=  # 任意。未設定ならメイク提案はルールベースにフォールバック
