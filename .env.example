# ローカル（Docker）: npx supabase status のキー / リモート: Project Settings → API のキー
# Docker なしの手順は README「Docker なしで開発する（リモート Supabase 接続）」を参照
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORM=  # 既定で Storage の画像変換（リサイズ/WebP）を通す。使えない環境は false
OPENAI_API_KEY=  # 任意。未設定ならメイク提案はルールベースにフォールバック
